{
  "name": "@yun520-1/heartflow",
  "version": "6.8.238",
  "description": "HeartFlow (\u5fc3\u866b) \u2014 AGI Layer 1: the Discriminator. Rule-based engine that checks what AI says before it reaches humans. 292 discrimination dimensions, 11-layer pipeline, 169 modules (logic/decision/cognition/emotion/memory/ethics/collaboration), 198 MCP tools, 1,390 dispatch routes. Zero LLM dependency. The gate that says NO when something is wrong.",
  "main": "src/gate.js",
  "bin": {
    "heartflow": "src/mcp-server.js"
  },
  "scripts": {
    "prepublishOnly": "node scripts/sync-version.js",
    "start": "node bin/cli.js chat",
    "status": "curl -sS --noproxy '*' --max-time 8 -f http://127.0.0.1:8588/health | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{let j;try{j=JSON.parse(s)}catch(e){console.error('heartflow status: /health \u8fd4\u56de\u975e JSON\uff08\u670d\u52a1\u53ef\u80fd\u5df2\u574f\uff09');process.exit(1)}if(j.status!=='ok'){console.error('heartflow status: /health \u62a5 status='+j.status+'\uff0c\u670d\u52a1\u4e0d\u5065\u5eb7');process.exit(1)}console.log(JSON.stringify({status:'ok',version:j.version,clients:j.clients,source:'http://127.0.0.1:8588/health'},null,2))})\" || { echo 'heartflow status: \u8bfb\u4e0d\u5230 127.0.0.1:8588/health\uff08\u7aef\u53e3\u672a\u76d1\u542c / \u670d\u52a1\u672a\u8fd0\u884c / \u5df2\u6302\u6b7b\uff09\uff1b\u542f\u52a8\u7528 npm start'; exit 1; }",
    "test": "node test/run-all.js",
    "test:integration": "node test/integration.test.js",
    "test:unit": "node test/core/path-guard.test.js && node test/code-verifier.test.js",
    "test:full": "HF_RUN_ALL_JOBS=1 node test/run-all.js",
    "verify": "node bin/verify.js",
    "check": "node -e \"require('fs').readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execSync('node --check src/'+f,{stdio:'inherit'}))\"",
    "backup": "bash /root/ops-runbook/scripts/heartflow-backup.sh"
  },
  "files": [
    "VERSION",
    "README.md",
    "AGENTS.md",
    "SKILL.md",
    "SECURITY.md",
    "LICENSE",
    "src/",
    "bin/",
    "test/",
    "scripts/"
  ],
  "keywords": [
    "ai-safety",
    "text-discrimination",
    "sycophancy-detection",
    "llm-guard",
    "mcp-server",
    "cognitive-architecture",
    "rule-engine",
    "content-moderation",
    "ai-alignment",
    "prompt-injection-detection",
    "truthfulness-check",
    "logical-fallacy-detection",
    "emotion-analysis",
    "ai-psychology",
    "heartflow",
    "\u5fc3\u866b",
    "agi",
    "agi-layer-1",
    "discrimination-gate",
    "ai-output-gate",
    "llm-guardrails"
  ],
  "security": {
    "audit": "mathjs and @xenova/transformers are loaded lazily inside try/catch and degrade gracefully when absent. js-yaml and pm2 declarations were removed (zero references in src/).",
    "warnings": [
      "No automatic external data transmission. All network communication requires explicit configuration.",
      "No automatic API key injection. Users must provide keys explicitly.",
      "Benchmark MCP tools enforce guardPath confinement; git commands run parameterized (no shell interpolation)."
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "~2.17.2",
    "mathjs": "~15.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-cell-520/heartflow.git"
  },
  "homepage": "https://github.com/mark-cell-520/heartflow#readme",
  "bugs": {
    "url": "https://github.com/mark-cell-520/heartflow/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "protobufjs": "^7.2.5"
  },
  "heartflow": {
    "skills": "skills/",
    "workflows": [
      "heartflow-architecture-tracing",
      "heartflow-audit-upgrade-push",
      "heartflow-benchmark",
      "heartflow-bridge-layer",
      "heartflow-bulk-upgrade",
      "heartflow-debug-workflow",
      "heartflow-dreaming",
      "heartflow-emotion-analysis",
      "heartflow-module-upgrader",
      "heartflow-session-context",
      "heartflow-static-injection-upgrade",
      "heartflow-system-prompt-absorption",
      "mind-space",
      "two-pass-response"
    ]
  },
  "features": {
    "v5.8.0": {
      "entityExtractor": "src/memory/entity-extractor.js",
      "memoryScorer": "src/memory/memory-scorer.js",
      "sessionManager": "src/memory/session-manager.js",
      "signalTracker": "src/memory/signal-tracker.js",
      "programmableGuardrails": "src/shield/programmable-guardrails.js"
    }
  },
  "author": {
    "name": "markcell",
    "email": "markcell@qq.com"
  },
  "exports": {
    ".": "./src/gate.js",
    "./gate": "./src/gate.js",
    "./pipeline": "./src/pipeline.js",
    "./discriminate": "./src/index.js",
    "./engine": "./src/core/heartflow.js",
    "./package.json": "./package.json"
  }
}
